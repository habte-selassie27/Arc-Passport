# Arc network
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_BLOCKCHAIN_ENV=ARC-TESTNET

# Circle SDK
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_ISSUER_WALLET_ID=
# Per-service issuer wallet IDs (attestation service expansion)
CIRCLE_IDENTITY_ISSUER_WALLET_ID=
CIRCLE_KYC_ISSUER_WALLET_ID=
CIRCLE_CREDENTIALS_ISSUER_WALLET_ID=
CIRCLE_DAO_ISSUER_WALLET_ID=
CIRCLE_REPUTATION_ISSUER_WALLET_ID=
CIRCLE_EMPLOYMENT_ISSUER_WALLET_ID=
CIRCLE_EDUCATION_ISSUER_WALLET_ID=
CIRCLE_SOCIAL_ISSUER_WALLET_ID=
CIRCLE_CUSTOM_ISSUER_WALLET_ID=
# Humanode humanity-proof issuer wallet (holds ISSUER_ROLE; writes arcpass_humanity claims)
CIRCLE_HUMANITY_ISSUER_WALLET_ID=

# Deployed contract addresses (populated after Deploy.s.sol)
ATTESTATION_REGISTRY_ADDRESS=
SCHEMA_REGISTRY_ADDRESS=
PASSPORT_VERIFIER_ADDRESS=
BATCH_ATTESTATION_ADDRESS=
SCORE_REGISTRY_ADDRESS=
SCORER_REGISTRY_ADDRESS=
CIRCLE_SCORE_WRITER_WALLET_ID=
HUMANITY_GATE_ADDRESS=

# IPFS
PINATA_API_KEY=
PINATA_SECRET_KEY=

# App
PORT=3001
JWT_SECRET=
NODE_ENV=development

# Score layer
SCORE_TTL_SECONDS=86400
SCORE_CACHE_TTL_SECONDS=300
HUMANITY_THRESHOLD=200

# Embed SDK
ARCPASS_EMBED_ALLOWED_ORIGINS=

# Humanode (proof-of-personhood provider)
# OAuth2 app credentials from https://humanode.io (developer console)
HUMANODE_CLIENT_ID=
HUMANODE_CLIENT_SECRET=
HUMANODE_API_BASE_URL=https://api.humanode.io
HUMANODE_REDIRECT_URI=http://localhost:5173/human-node
# Lifetime (seconds) of the on-chain Humanity Proof attestation (default 180 days)
HUMANITY_ATTESTATION_TTL_SECONDS=15552000

# Primus Labs (Web2 data verification via zkTLS)
PRIMUS_API_KEY=
PRIMUS_API_SECRET=
PRIMUS_API_BASE_URL=https://api.primuslabs.xyz
PRIMUS_REDIRECT_URI=http://localhost:5173/web2-proof
# Web2 data proof issuer wallet (holds ISSUER_ROLE; writes arcpass_web2_data_proof claims)
CIRCLE_WEB2_PROOF_ISSUER_WALLET_ID=
WEB2_DATA_GATE_ADDRESS=

# OpenID3 — Web2 Identity Attestation
OPENID3_GITHUB_CLIENT_ID=
OPENID3_GITHUB_CLIENT_SECRET=
OPENID3_TWITTER_CLIENT_ID=
OPENID3_TWITTER_CLIENT_SECRET=
OPENID3_DISCORD_CLIENT_ID=
OPENID3_DISCORD_CLIENT_SECRET=
OPENID3_REDIRECT_BASE=http://localhost:5173
CIRCLE_OPENID3_ISSUER_WALLET_ID=
IDENTITY_GATE_ADDRESS=

# Foundry
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
